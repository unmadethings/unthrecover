# Unth Recover job: backup + isolated restore verification + retention + notify.
#
# One instance per job:  /etc/unth/jobs/<job>.yaml   (config, 0640 root:unth)
#                        /etc/unth/jobs/<job>.env    (secrets, 0600 root:root, optional)
# Enable:                systemctl enable --now unth@<job>.timer
# Run now:               systemctl start unth@<job>.service
# Logs:                  journalctl -u unth@<job>.service
#
# The service runs as the dedicated "unth" user, which must be in the "docker"
# group (Docker socket access is root-equivalent; see docs/SECURITY_THREAT_MODEL.md).
[Unit]
Description=Unth Recover job %i (backup + verified recovery test)
Documentation=https://github.com/unmadethings/unthrecover/blob/main/docs/SCHEDULING.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=unth
Group=unth
SupplementaryGroups=docker
Environment=UNTH_DATA_DIR=/var/lib/unthrecover
EnvironmentFile=-/etc/unth/jobs/%i.env
ExecStart=/usr/local/bin/unth run --config /etc/unth/jobs/%i.yaml --log-level info
# Exit 3 (not verified) and 4 (notification failed) are real failures and
# must surface as a failed unit; do not add them to SuccessExitStatus.
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Hardening (unth needs: its data dir, /tmp for private pgpass files, the
# Docker socket and outbound network to the source database).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/unthrecover
StateDirectory=unthrecover
StateDirectoryMode=0700
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
